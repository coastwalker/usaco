{
  "name": "usaco-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "USACO & LeetCode-style online coding practice platform with official test-case judging",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "prepare-data": "node scripts/prepare-public-data.js",
    "build": "node scripts/prepare-public-data.js && vite build && node scripts/obfuscate.js",
    "obfuscate": "node scripts/obfuscate.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.1",
    "codemirror": "^6.0.1",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "javascript-obfuscator": "^5.10.1",
    "vite": "^5.4.10"
